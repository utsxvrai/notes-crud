# Postgres on Amazon RDS. Either a full URL...
DATABASE_URL=postgres://notes:password@your-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/notes
# ...or PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE (e.g. injected from Secrets Manager)
# DATABASE_SSL=off   # only for a local Postgres without TLS

# Amazon S3 bucket for attachments
S3_BUCKET=notes-crud-attachments
AWS_REGION=ap-south-1

# HTTP
PORT=3000
