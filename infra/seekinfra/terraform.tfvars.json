{
  "app_name": "notes-crud",
  "region": "ap-south-1",
  "container_port": 3000,
  "health_check_path": "/healthz",
  "cpu": 256,
  "memory": 512,
  "desired_count": 1,
  "autoscaling": {
    "enabled": false,
    "min": 1,
    "max": 1
  },
  "database": {
    "enabled": true,
    "engine": "postgres",
    "version": "16",
    "instance": "db.t4g.micro",
    "storage_gb": 20,
    "multi_az": false,
    "backup_days": 7,
    "deletion_protection": false
  },
  "storage": {
    "enabled": true,
    "cors": true
  },
  "env": [
    {
      "name": "DATABASE_URL",
      "source": "database_url",
      "value": ""
    },
    {
      "name": "PGHOST",
      "source": "db_host",
      "value": ""
    },
    {
      "name": "PGPORT",
      "source": "db_port",
      "value": ""
    },
    {
      "name": "PGUSER",
      "source": "db_user",
      "value": ""
    },
    {
      "name": "PGPASSWORD",
      "source": "db_password",
      "value": ""
    },
    {
      "name": "PGDATABASE",
      "source": "db_name",
      "value": ""
    },
    {
      "name": "DATABASE_SSL",
      "source": "plain",
      "value": "true"
    },
    {
      "name": "S3_BUCKET",
      "source": "s3_bucket",
      "value": ""
    },
    {
      "name": "AWS_REGION",
      "source": "aws_region",
      "value": ""
    },
    {
      "name": "PORT",
      "source": "port",
      "value": ""
    },
    {
      "name": "HOST",
      "source": "plain",
      "value": "0.0.0.0"
    },
    {
      "name": "NODE_ENV",
      "source": "plain",
      "value": "production"
    }
  ]
}
